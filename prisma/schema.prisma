model Staff {
  id         String @id @default(uuid())
  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)
  username   String @unique @db.VarChar(50)
  password   String @db.VarChar(255)

  role Role @default(teacher)

  position  String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  hire_date DateTime @default(now()) @db.Date

  status Status @default(active)

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  groups      Group[]
  lessons     Lesson[]
  attendances Attendance[]
  payments    Payment[]

  @@map("staffs")
}

enum Role {
  superadmin
  admin
  teacher
}

enum Status {
  active
  inactive
}

model Student {
  id         String    @id @default(uuid())
  first_name String    @db.VarChar(100)
  last_name  String    @db.VarChar(100)
  username   String?   @unique @db.VarChar(50)
  password   String?   @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  address    String?   @db.Text
  birth_date DateTime? @db.Date

  status StudentStatus @default(active)

  enrollment_date   DateTime?          @default(now()) @db.Date
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  studentGroups     StudentGroup[]
  attendanceDetails AttendanceDetail[]
  payments          Payment[]

  @@map("students")
}

enum StudentStatus {
  active
  inactive
  graduated
}

model Course {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String? @db.Text
  price       Int
  duration    Int

  level Level? @default(beginner)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  groups     Group[]

  @@map("courses")
}

enum Level {
  beginner
  intermediate
  advanced
}

model Group {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(50)
  course_id    String
  teacher_id   String
  start_date   DateTime    @db.Date
  end_date     DateTime?   @db.Date
  schedule     String?     @db.Text
  max_students Int         @default(20)
  status       GroupStatus @default(planned)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  course        Course         @relation(fields: [course_id], references: [id])
  teacher       Staff          @relation(fields: [teacher_id], references: [id])
  studentGroups StudentGroup[]
  lessons       Lesson[]
  payments      Payment[]
  schedules     Schedule[]

  @@map("groups")
}

enum GroupStatus {
  planned
  active
  completed
}

model StudentGroup {
  id         String             @id @default(uuid())
  student_id String
  group_id   String
  join_date  DateTime?          @default(now()) @db.Date
  status     StudentGroupStatus @default(active)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  student Student @relation(fields: [student_id], references: [id])
  group   Group   @relation(fields: [group_id], references: [id])

  @@unique([student_id, group_id])
  @@map("student_groups")
}

enum StudentGroupStatus {
  active
  inactive
  completed
}

model Lesson {
  id          String   @id @default(uuid())
  group_id    String
  title       String?  @db.VarChar(255)
  description String?  @db.Text
  lesson_date DateTime @db.Date
  start_time  DateTime @db.Time
  end_time    DateTime @db.Time
  room_number String?  @db.VarChar(20)
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group       Group        @relation(fields: [group_id], references: [id])
  creator     Staff        @relation(fields: [created_by], references: [id])
  attendances Attendance[]

  @@map("lessons")
}

model Attendance {
  id         String   @id @default(uuid())
  lesson_id  String
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson            Lesson             @relation(fields: [lesson_id], references: [id])
  creator           Staff              @relation(fields: [created_by], references: [id])
  attendanceDetails AttendanceDetail[]

  @@map("attendance")
}

model AttendanceDetail {
  id            String           @id @default(uuid())
  attendance_id String
  student_id    String
  status        AttendanceStatus
  comment       String?          @db.Text

  attendance Attendance @relation(fields: [attendance_id], references: [id])
  student    Student    @relation(fields: [student_id], references: [id])

  @@unique([attendance_id, student_id])
  @@map("attendance_details")
}

enum AttendanceStatus {
  present
  absent
  late
}

model Payment {
  id             String        @id @default(uuid())
  student_id     String
  group_id       String
  amount         Int
  payment_date   DateTime?     @default(now()) @db.Date
  payment_method PaymentMethod
  description    String?       @db.Text
  receipt_number String?       @db.VarChar(50)
  created_by     String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  student Student @relation(fields: [student_id], references: [id])
  group   Group   @relation(fields: [group_id], references: [id])
  creator Staff   @relation(fields: [created_by], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  cash
  card
  transfer
}

model Schedule {
  id          String   @id @default(uuid())
  group_id    String
  day         Day
  start_time  DateTime @db.Time
  end_time    DateTime @db.Time
  room_number String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id])

  @@unique([group_id, day, start_time])
  @@map("schedule")
}

enum Day {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}
