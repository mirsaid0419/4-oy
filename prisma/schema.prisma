model Rooms {
  id     String     @id @default(uuid())
  name   String     @unique
  status RoomStatus @default(active)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  groups     Groups[]
}

enum RoomStatus {
  active
  inactive
}

model Teacher {
  id             String @id @default(uuid())
  specialization String @db.VarChar(100)
  education      String @db.VarChar(100)
  experience     Int

  staffId String @unique
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  groups          Groups[]
  lessons         Lesson[]
  attendances     Attendance[]
  homework        Homework[]
  homeworkResults HomeworkResult[]

  @@map("teachers")
}

model Staff {
  id         String  @id @default(uuid())
  first_name String  @db.VarChar(100)
  last_name  String  @db.VarChar(100)
  username   String  @unique @db.VarChar(50)
  password   String  @db.VarChar(255)
  photo      String? @db.VarChar(255)
  email      String  @unique

  role Role @default(teacher)

  position  String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  hire_date DateTime @default(now()) @db.Date

  status Status @default(active)

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  lessons     Lesson[]
  attendances Attendance[]
  payments    Payment[]
  teacher     Teacher?
  homework    Homework[]

  @@map("staffs")
}

enum Role {
  superadmin
  admin
  teacher
}

enum Status {
  active
  inactive
}

model Student {
  id         String    @id @default(uuid())
  first_name String    @db.VarChar(100)
  last_name  String    @db.VarChar(100)
  username   String?   @unique @db.VarChar(50)
  email      String    @unique
  password   String?   @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  address    String?   @db.Text
  birth_date DateTime? @db.Date
  photo      String?   @db.VarChar(255)

  status StudentStatus @default(active)

  enrollment_date        DateTime?               @default(now()) @db.Date
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  studentGroups          StudentGroup[]
  attendanceDetails      AttendanceDetail[]
  payments               Payment[]
  homeworkAnswerStudents HomeworkAnswerStudent[]
  homeworkResults        HomeworkResult[]

  @@map("students")
}

enum StudentStatus {
  active
  inactive
  graduated
}

model Course {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  price          Decimal
  duration_month Int
  duration_hours Int
  level          Level    @default(beginner)
  status         Status   @default(active)
  created_at     DateTime @default(now())
  update_at      DateTime @updatedAt

  groups Groups[]
}

enum Level {
  beginner
  intermediate
  advanced
}

enum GroupStatus {
  planned
  active
  completed
}

model Groups {
  id           String      @id @default(uuid())
  name         String
  description  String?
  course_id    String
  teacher_id   String
  room_id      String
  start_date   DateTime
  week_day     String[]
  start_time   String
  max_students Int         @default(20)
  status       GroupStatus @default(planned)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @default(now())

  course                 Course                  @relation(fields: [course_id], references: [id])
  teacher                Teacher                 @relation(fields: [teacher_id], references: [id])
  rooms                  Rooms                   @relation(fields: [room_id], references: [id])
  studentGroups          StudentGroup[]
  lessons                Lesson[]
  payments               Payment[]
  schedules              Schedule[]
  homework               Homework[]
  homeworkAnswerStudents HomeworkAnswerStudent[]
  homeworkResults        HomeworkResult[]
}

model StudentGroup {
  id         String   @id @default(uuid())
  student_id String
  group_id   String
  status     Status   @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  students Student @relation(fields: [student_id], references: [id])
  groups   Groups  @relation(fields: [group_id], references: [id])
}

enum StudentGroupStatus {
  active
  inactive
  completed
}

model Lesson {
  id          String   @id @default(uuid())
  group_id    String
  teacher_id  String?
  staff_id    String?
  topic       String   @db.VarChar(255)
  description String?  @db.Text
  status      Status   @default(active)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group       Groups       @relation(fields: [group_id], references: [id])
  teacher     Teacher?     @relation(fields: [teacher_id], references: [id])
  staff       Staff?       @relation(fields: [staff_id], references: [id])
  attendances Attendance[]
  homework    Homework[]

  @@map("lessons")
}

model Attendance {
  id         String   @id @default(uuid())
  lesson_id  String
  teacher_id String?
  staff_id   String?
  student_id String
  isPresent  Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson            Lesson             @relation(fields: [lesson_id], references: [id])
  staffs            Staff?             @relation(fields: [staff_id], references: [id])
  teachers          Teacher?           @relation(fields: [teacher_id], references: [id])
  attendanceDetails AttendanceDetail[]

  @@map("attendance")
}

model Homework {
  id         String   @id @default(uuid())
  lesson_id  String
  teacher_id String?
  staff_id   String?
  group_id   String
  title      String
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  lesson     Lesson   @relation(fields: [lesson_id], references: [id])
  staffs     Staff?   @relation(fields: [staff_id], references: [id])
  teachers   Teacher? @relation(fields: [teacher_id], references: [id])
  groups     Groups   @relation(fields: [group_id], references: [id])
}

model HomeworkAnswerStudent {
  id          String   @id @default(uuid())
  student_id  String
  homework_id String
  title       String
  file        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  students Student @relation(fields: [student_id], references: [id])
  homework Groups  @relation(fields: [homework_id], references: [id])
}

model HomeworkResult {
  id                 String   @id @default(uuid())
  homework_answer_id String
  teacher_id         String?
  staff_id           String?
  grade              Int
  title              String
  status             Boolean
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  teachers Teacher? @relation(fields: [teacher_id], references: [id])
  staffs   Student? @relation(fields: [staff_id], references: [id])

  homeworkAnswerStudent Groups @relation(fields: [homework_answer_id], references: [id])
}

model AttendanceDetail {
  id            String           @id @default(uuid())
  attendance_id String
  student_id    String
  status        AttendanceStatus
  comment       String?          @db.Text

  attendance Attendance @relation(fields: [attendance_id], references: [id])
  student    Student    @relation(fields: [student_id], references: [id])

  @@unique([attendance_id, student_id])
  @@map("attendance_details")
}

enum AttendanceStatus {
  present
  absent
  late
}

model Payment {
  id             String        @id @default(uuid())
  student_id     String
  group_id       String
  amount         Int
  payment_date   DateTime?     @default(now()) @db.Date
  payment_method PaymentMethod
  description    String?       @db.Text
  receipt_number String?       @db.VarChar(50)
  created_by     String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  student Student @relation(fields: [student_id], references: [id])
  group   Groups  @relation(fields: [group_id], references: [id])
  creator Staff   @relation(fields: [created_by], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  cash
  card
  transfer
}

model Schedule {
  id          String   @id @default(uuid())
  group_id    String
  day         Day
  start_time  DateTime @db.Time
  end_time    DateTime @db.Time
  room_number String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group Groups @relation(fields: [group_id], references: [id])

  @@unique([group_id, day, start_time])
  @@map("schedule")
}

enum Day {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}
