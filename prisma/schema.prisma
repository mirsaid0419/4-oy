generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum Status {
  active
  inactive
  freeze
}

enum StudentStatus {
  active
  inactive
  freeze
  graduated
}

enum GroupStatus {
  planned
  active
  completed
}

enum WeekDay {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

model User {
  id         Int      @id @default(autoincrement())
  first_name String
  last_name  String
  email      String   @unique
  password   String
  role       UserRole
  phone      String   @unique
  address    String?
  photo      String?
  status     Status   @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model Students {
  id            Int            @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String         @unique
  password      String
  phone         String         @unique
  address       String?
  photo         String?
  birth_date    DateTime
  status        StudentStatus  @default(active)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now())
  studentGroups StudentGroup[]
}

model Teachers {
  id         Int      @id @default(autoincrement())
  first_name String
  last_name  String
  email      String   @unique
  password   String
  phone      String   @unique
  address    String?
  photo      String?
  status     Status   @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  groups Groups[]
}

model Courses {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String
  price          Int
  duration_month Int
  duration_hours Int
  level          String
  status         Status   @default(active)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  groups Groups[]
}

model Rooms {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  groups Groups[]
}

model Groups {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  course_id    Int
  teacher_id   Int
  room_id      Int
  start_date   DateTime
  week_day     Json
  start_time   String
  max_students Int      @default(20)
  status       String   @default("planned")
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  course        Courses        @relation(fields: [course_id], references: [id])
  teacher       Teachers       @relation(fields: [teacher_id], references: [id])
  rooms         Rooms          @relation(fields: [room_id], references: [id])
  studentGroups StudentGroup[]
}

model StudentGroup {
  id         Int      @id @default(autoincrement())
  student_id Int
  group_id   Int
  status     Status   @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  students Students @relation(fields: [student_id], references: [id])
  groups   Groups   @relation(fields: [group_id], references: [id])
}
